# Time services. Per atmosphere, system clock returns posix seconds since
# 2000-01-01. Other commands return zero-initialised blobs sized per the
# expected struct (CalendarTime, SteadyClockTimePoint, etc.) — enough to keep
# the guest's libnx happy through trivial init paths.
#
# Source: firmware IPC dump (525hpm0.txt) —
#   'nn::timesrv::detail::service::ISystemClock'      (vtable 5)
#   'nn::timesrv::detail::service::ISteadyClock'      (vtable 7)
#   'nn::timesrv::detail::service::ITimeZoneService'  (vtable 14)
# IStaticService cmds 0-5 return sub-sessions and are routed elsewhere.

service ISystemClock as system_clock {
    [0] GetCurrentTime() -> u64;
    [1] SetCurrentTime(u64 posix_time);
    [2] GetSystemClockContext() -> bytes(0x20);
    [3] SetSystemClockContext();
    [4] GetOperationEventReadableHandle() -> out_handle;
}

service ISteadyClock as steady_clock {
    [0] GetCurrentTimePoint() -> bytes(0x18);
    [2] GetTestOffset() -> u64;
    [3] SetTestOffset(u64 offset);
    [100] GetRtcValue() -> u64;
    [101] IsRtcResetDetected() -> bool;
    [102] GetSetupResultValue() -> u32;
    [200] GetInternalOffset() -> u64;
}

service ITimeZoneService as time_zone {
    [0] GetDeviceLocationName() -> bytes(0x24);
    # NOTE [1] takes a 0x24 LocationName input; we ignore it in the handler.
    [1] SetDeviceLocationName();
    [2] GetTotalLocationNameCount() -> u32;
    # NOTE [3] writes a MapAlias Out buffer of entry_size=0x24; ignored.
    [3] LoadLocationNameList(u32 index) -> u32;
    # NOTE [4] takes a LocationName, writes a 0x4000 TimeZoneRule; ignored.
    [4] LoadTimeZoneRule();
    [5] GetTimeZoneRuleVersion() -> zeros(0x10);
    [6] GetDeviceLocationNameAndUpdatedTime() -> zeros(0x40);
    # NOTE [7] takes LocationName + AutoSelect TimeZoneRule input; ignored.
    [7] SetDeviceLocationNameWithTimeZoneRule();
    # NOTE [8] writes 0x4000 rule from AutoSelect input; ignored.
    [8] ParseTimeZoneBinary();
    [20] GetDeviceLocationNameOperationEventReadableHandle() -> out_handle;
    # NOTE [100] also takes a 0x4000 TimeZoneRule MapAlias In; ignored.
    [100] ToCalendarTime(u64 posix_time) -> zeros(0x20);
    [101] ToCalendarTimeWithMyRule(u64 posix_time) -> zeros(0x20);
    # NOTE [201] takes a 0x4000 TimeZoneRule In and writes posix times to an Out|Pointer buffer; ignored.
    [201] ToPosixTime(u64 calendar_time) -> u32;
    # NOTE [202] writes posix times to an Out|Pointer buffer; ignored.
    [202] ToPosixTimeWithMyRule(u64 calendar_time) -> u32;
}
